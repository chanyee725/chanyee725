---
// 테마 선택 드롭다운 대신 아이콘 버튼 하나. 누르면 라이트 ↔ 다크.
// 저장 키는 Starlight와 같은 starlight-theme이라 첫 화면 깜빡임 없이 이어진다.
import { Icon } from "@astrojs/starlight/components"
---

<button type="button" class="theme-toggle" aria-label="라이트·다크 바꾸기" title="라이트·다크 바꾸기">
  <Icon name="moon" class="to-dark" />
  <Icon name="sun" class="to-light" />
</button>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".theme-toggle")) {
    btn.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark"
      document.documentElement.dataset.theme = next
      try {
        localStorage.setItem("starlight-theme", next)
      } catch {
        // 저장이 막혀 있어도 이번 화면에서는 바뀐다
      }
    })
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .theme-toggle :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  :global([data-theme="dark"]) .to-dark,
  :global([data-theme="light"]) .to-light {
    display: none;
  }
</style>
