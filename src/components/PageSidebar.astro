---
// 오른쪽 칸: 홈에서는 태그 목록, 글에서는 기본 목차
import Default from "@astrojs/starlight/components/PageSidebar.astro"

import TagCloud from "./TagCloud.astro"

const strip = (p: string) => p.replace(/\/+$/, "")
const isHome = strip(Astro.url.pathname) === strip(import.meta.env.BASE_URL)
---

{
  isHome ? (
    <div class="right-sidebar-panel sl-hidden lg:sl-block">
      <div class="sl-container">
        <TagCloud />
      </div>
    </div>
  ) : (
    <Default />
  )
}

<style>
  .right-sidebar-panel {
    padding: 1rem var(--sl-sidebar-pad-x);
  }
  .sl-container {
    width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    max-width: 100%;
  }
  .right-sidebar-panel :global(h2) {
    color: var(--sl-color-white);
    font-size: var(--sl-text-h5);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .right-sidebar-panel :global(a) {
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }
  .right-sidebar-panel :global(a:hover) {
    color: var(--sl-color-white);
  }
</style>
