---
// 글 목록 (홈 최신글, 태그 페이지). thumbnail이 있으면 오른쪽에 작게 붙인다.
import { CATEGORY_LABEL, formatDate } from "../categories"
import { base, excerpt, type Post } from "../posts"

type Props = { posts: Post[]; heading?: string }
const { posts, heading } = Astro.props
const PAGE = 8
---

<section class="post-list not-content">
  {heading && <h2>{heading}</h2>}
  <ul>
    {
      posts.map((p, i) => (
        <li hidden={i >= PAGE}>
          <a href={`${base}/${p.id}/`}>
            <div class="text">
              <div class="head">
                <span class="title">{p.data.title}</span>
                <span class="cat">{CATEGORY_LABEL[p.id.split("/")[0]]}</span>
                <time datetime={p.data.date!.toISOString()}>{formatDate(p.data.date!)}</time>
              </div>
              <p>{p.data.description ?? excerpt(p.body)}</p>
            </div>
            {p.data.thumbnail && <img src={base + p.data.thumbnail} alt="" loading="lazy" />}
          </a>
        </li>
      ))
    }
  </ul>
  {posts.length > PAGE && <button type="button" class="more">+ 더보기</button>}
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".post-list .more")
  btn?.addEventListener("click", () => {
    const hidden = [...document.querySelectorAll<HTMLLIElement>(".post-list li[hidden]")]
    hidden.slice(0, 8).forEach((li) => (li.hidden = false))
    if (hidden.length <= 8) btn.remove()
  })
</script>

<style>
  .post-list {
    margin-top: 3rem;
  }
  h2 {
    font-size: var(--sl-text-base);
    font-weight: 400;
    color: var(--sl-color-gray-2);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--sl-color-gray-2);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li a {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--sl-color-hairline);
    color: inherit;
    text-decoration: none;
  }
  .text {
    flex: 1;
    min-width: 0;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }
  .title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  li a:hover .title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .cat {
    padding-left: 0.6rem;
    border-left: 1px solid var(--sl-color-gray-4);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  time {
    margin-left: auto;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
  p {
    margin: 0.35rem 0 0;
    color: var(--sl-color-gray-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  img {
    width: 7.5rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--sl-color-hairline);
    flex-shrink: 0;
  }
  .more {
    display: block;
    margin: 1.5rem auto 0;
    padding: 0.25rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  @media (max-width: 40rem) {
    img {
      width: 5.5rem;
    }
    time {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
