---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"

import PostList from "../../components/PostList.astro"
import { getPosts, tagCounts } from "../../posts"

export async function getStaticPaths() {
  const posts = await getPosts()
  return tagCounts(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }))
}

const { tag, posts } = Astro.props
---

<StarlightPage frontmatter={{ title: `#${tag}`, tableOfContents: false, prev: false, next: false }}>
  <p>글 {posts.length}개</p>
  <PostList posts={posts} />
</StarlightPage>
